# Provider Configurations
LLM_PROVIDER=bedrock # options: bedrock, openai
EMBEDDING_PROVIDER=bedrock # options: bedrock, mock
VECTOR_STORE=qdrant # options: qdrant, in_memory

# AWS Bedrock Configuration
AWS_REGION=ap-south-1
# Use either direct Bearer token (Bedrock API key) OR standard IAM credentials
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
BEDROCK_LLM_MODEL_ID=qwen.qwen3-235b-a22b-2507-v1:0
# Optional: comma-separated or JSON list of models to expose in UI
BEDROCK_MODELS=qwen.qwen3-235b-a22b-2507-v1:0:Qwen 3 235B A22B:Advanced open-weight reasoning model on AWS Bedrock,anthropic.claude-sonnet-4-6:Claude Sonnet 4.6:Anthropic flagship reasoning model on AWS Bedrock
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Groq Cloud Configuration (Fast, Free Tier Available)
GROQ_API_KEY=gsk_your_groq_api_key_here
# (Optional overrides - defaults are automatic when GROQ_API_KEY is present)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL_ID=llama-3.3-70b-versatile

# Standard OpenAI Configuration (if using OpenAI instead of Groq)
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL_ID=gpt-4o

# Qdrant Cloud Vector Database Configuration
QDRANT_URL=https://your-cluster.qdrant.tech:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=engineering_knowledge_base

# Service Defaults
DEFAULT_MICROSERVICE=income-assessment-service
