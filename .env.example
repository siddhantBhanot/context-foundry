# ==============================================================================
# ContextFoundry — Environment Configuration
# ==============================================================================

# Backend & Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATABASE_PATH=backend_service/data/contextfoundry.db

# Account creation + hardcoded "Software Engineer Demo" sign-in.
# Set to false in cloud deployments: signup returns 403, the demo account cannot be
# provisioned or used to log in, and the UI hides both. Existing real users can still sign in.
ALLOW_USER_REGISTRATION=true
JWT_SECRET_KEY=change-this-to-a-secure-random-32-character-secret-key

# RAG Engine Pipeline Mode ("direct" bridges in-process to rag_service; "mock" runs offline)
RAG_CLIENT_MODE=direct

# LLM & Embedding Providers
LLM_PROVIDER=groq # options: groq, gemini, bedrock, openai
EMBEDDING_PROVIDER=qdrant # options: qdrant, gemini, bedrock, mock
# When false (default), uses Gemini API embeddings (gemini-embedding-001) when GEMINI_API_KEY is configured.
# Set to true to run local in-process FastEmbed ONNX (jinaai/jina-embeddings-v2-base-code, requires ~900MB RAM).
USE_LOCAL_JINA_EMBEDDINGS=false
GEMINI_EMBEDDING_MODEL_ID=gemini-embedding-001
QDRANT_EMBEDDING_MODEL=jinaai/jina-embeddings-v2-base-code
EMBEDDING_DIMENSION=768
VECTOR_STORE=qdrant # options: qdrant, in_memory

# Groq Cloud Configuration (Fast, Free Tier Available for Demos)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini Configuration (1M Context Window, Fast & Deep Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.7-flash
# Seconds to wait for a Gemini model's first token before failing over to the next model
GEMINI_FIRST_TOKEN_TIMEOUT_SECONDS=25

# AWS Bedrock Configuration (Optional)
AWS_REGION=ap-south-1
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_bearer_token_here
BEDROCK_LLM_MODEL_ID=anthropic.claude-sonnet-4-6
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Qdrant Vector Database (Local or Cloud Cluster)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_if_cloud
QDRANT_COLLECTION_NAME=engineering_knowledge_base

# Frontend Base URL
VITE_API_BASE_URL=http://localhost:8000
