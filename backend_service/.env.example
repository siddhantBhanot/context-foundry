# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,*

# Persistence Settings
DATABASE_PATH=data/contextfoundry.db

# RAG Adapter Mode ("direct" bridges in-process to rag_service; "mock" runs offline)
RAG_CLIENT_MODE=direct

# Microservice Defaults
DEFAULT_SERVICE=income-assessment-service
DEFAULT_TOP_K=5
